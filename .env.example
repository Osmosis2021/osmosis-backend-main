# Server Configuration
PORT=8126
NODE_ENV=development

# Database
MONGOOSE_CONNECTION_STRING=mongodb://localhost:27017/osmosis

# JWT Secrets
ACCESS_TOKEN_SECRET=some_jwt_access_secret_here
REFRESH_TOKEN_SECRET=some_jwt_refresh_secret_here

# Resend Email Integration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=hello@getstudiotime.com

# Stripe Integration (optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the second webhook endpoint ("Connected accounts", event account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Google Sign-In (must match REACT_APP_GOOGLE_CLIENT_ID on the frontend)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe mode: 'test' or 'live'. Defaults to live when NODE_ENV=production.
# Set STRIPE_MODE=test to run production against Stripe test keys before launch.
STRIPE_MODE=test
STRIPE_TEST_KEY=
STRIPE_PUBLISHABLE_TEST_KEY=
# STRIPE_LIVE_KEY=
# STRIPE_PUBLISHABLE_KEY=

# Public address of the web app (Stripe sends hosts back here after onboarding)
FRONTEND_URL=https://getstudiotime.com
